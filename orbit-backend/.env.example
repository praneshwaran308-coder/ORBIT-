# ORBIT backend — Freebuff provider configuration
#
# ORBIT resolves the LLM provider in this order:
#   1. FREEBUFF_* environment variables (below) — explicit override
#   2. Freebuff Desktop's BYOK store:
#        ~/.config/freebuff/byok/connections.json
#        + the connection's credential in the OS keychain
#          (service "com.freebuff.byok.v1", read via Freebuff's bundled Bun)
#
# If a BYOK connection exists (e.g. OpenRouter), ORBIT uses it automatically —
# no env vars required. Everything below is optional.

# Optional explicit overrides:
# FREEBUFF_API_KEY=your-key
# FREEBUFF_BASE_URL=https://openrouter.ai/api/v1
# FREEBUFF_MODEL=openai/gpt-4o-mini

# Optional BYOK tuning:
# FREEBUFF_BYOK_CONNECTION_ID=<pick a specific connection by id>
# FREEBUFF_BUN_PATH=<path to Freebuff's bun.exe if not auto-detected>
# FREEBUFF_BYOK_CONFIG_DIR=<alternate BYOK config directory>

# Optional client tuning:
# FREEBUFF_TIMEOUT_SECONDS=60
# FREEBUFF_MAX_RETRIES=2
# MAX_UPLOAD_BYTES=20971520
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
