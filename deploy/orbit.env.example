# ORBIT production environment template
#
# Copy to /etc/orbit/orbit.env on the server, fill in real values, then:
#   sudo chown root:orbit /etc/orbit/orbit.env
#   sudo chmod 640 /etc/orbit/orbit.env
#
# NEVER commit a filled-in copy of this file. Placeholders only here.

# --- Provider credential (SECRET) -------------------------------------------
# The LLM provider key used through Freebuff's provider integration.
FREEBUFF_API_KEY=REPLACE_WITH_REAL_KEY

# --- Provider endpoint / model (operator config, not secret) ----------------
# OpenAI-compatible chat-completions endpoint; HTTPS required in production.
FREEBUFF_BASE_URL=https://openrouter.ai/api/v1
FREEBUFF_MODEL=openai/gpt-4o-mini

# --- CORS -------------------------------------------------------------------
# Exact browser origin(s) allowed to call the API (comma-separated).
# Never use "*" with credentials enabled.
CORS_ORIGINS=https://orbit.example.com

# --- Limits & reliability ---------------------------------------------------
# Maximum accepted CSV upload (bytes).
MAX_UPLOAD_BYTES=10485760
# Wall-clock watchdog per task (seconds); late results are discarded.
TASK_TIMEOUT_SECONDS=120
# 0 = hide /docs, /redoc, /openapi.json (production). 1 = development only.
ENABLE_API_DOCS=0
